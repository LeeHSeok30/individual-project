<!doctype html><html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Rolling score lab</title><style>
*{box-sizing:border-box}body{margin:0;background:#faf8f2;color:#182f32;font:17px/1.45 system-ui,sans-serif}main{max-width:950px;margin:30px auto;padding:12px 35px}h1{font-size:37px;margin:8px 0 16px}h2{font-size:18px;margin:19px 0 6px}select,button{font:inherit;padding:5px;color:inherit;background:white;border:1px solid #9fafac;border-radius:4px}label{margin-right:16px}.row{display:flex;align-items:end;gap:9px;height:145px;border-bottom:1px solid #92aaa5;padding:0 10px}.column{text-align:center;flex:1;color:#6c7977}.bar{background:#c7cfcb;width:100%;height:var(--h)}.in .bar{background:#309384}.leading .bar{background:#cb592f}.column b{font-size:19px}.legend{font-size:14px;color:#325b55}.queue{font:19px ui-monospace,monospace;color:#075d55}input[type=range]{width:min(47vw,385px);vertical-align:middle}#stats{border-top:1px solid #bdcbc7;padding-top:10px}output{font-weight:bold}</style>
<main><h1>Rolling score lab</h1>
<label>Record <select id="record"></select></label><label>On a tie <select id="tie"><option>Keep newest</option><option>Keep oldest</option></select></label>
<h2 id="head"></h2><div class="row" id="bars"></div><p class="legend">Gray: outside the active window · Teal: in window · Orange: leading candidate</p>
<label>Game <input id="step" type="range" min="1"><output id="game"></output></label>
<h2>Deque from front to back</h2><div class="queue" id="queue"></div>
<p id="stats"></p><p id="verified"></p></main>
<script>
const data=TRACE_DATA;
const at=id=>document.getElementById(id);
const select=at('record'), tie=at('tie'),step=at('step');
for(const d of data)select.add(new Option(d.name));
function reset(){const d=data[select.selectedIndex];step.max=d.x.length;step.value=d.dates?48:step.max;draw()}
function draw(){
 const d=data[select.selectedIndex],i=Number(step.value)-1,row=d.modes[tie.selectedIndex][i];
 at('game').textContent=String(i+1)+(d.dates?' · '+d.dates[i]:'');at('head').textContent='Points per game · window '+d.k;
 at('bars').replaceChildren();
 const first=d.dates?Math.max(0,i-9):0;
 const shown=d.dates?d.x.slice(first,i+1):d.x;
 shown.forEach((v,offset)=>{const j=first+offset;const cell=document.createElement('div');cell.className='column'+(j>i-d.k&&j<=i?' in':'')+(j===row.queue[0]?' leading':'');
 const val=document.createElement('b');val.textContent=v;const bar=document.createElement('div');bar.className='bar';bar.style.setProperty('--h',(88*v/Math.max(...d.x))+'px');
 cell.append(val,bar);const lbl=document.createElement('small');lbl.textContent='G'+(j+1);cell.append(lbl);at('bars').append(cell)});
 at('queue').textContent=row.queue.map(j=>'G'+(j+1)+' ('+d.x[j]+')').join('   →   ');
 at('stats').textContent='Window maximum: '+(row.maximum??'warming up')+'   ·   Score comparisons this update: '+row.c+'   ·   Back removals: '+row.p;
 at('verified').textContent=d.dates?'All three Python methods agree on all 70 complete windows. The chart shows up to the last 10 appearances.':'All three Python methods agree. Complete output: ['+d.answers.join(', ')+']';
}
select.onchange=reset;tie.onchange=draw;step.oninput=draw;reset();</script></html>
